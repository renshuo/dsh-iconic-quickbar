{
  "name": "@renshuo/dsh-iconic-quickbar",
  "version": "1.1.1",
  "description": "把 DeepSeek Harness 左侧栏「新建会话」下方的面板列表改为一行无文字图标按钮（面板由宿主注册决定，不写死清单），行尾带开关可在原版列表与图标行之间切换。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/dom.test.mjs",
    "test:visual": "node test/visual.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "sidebar",
    "plugin"
  ],
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renshuo/dsh-iconic-quickbar.git"
  },
  "bugs": {
    "url": "https://github.com/renshuo/dsh-iconic-quickbar/issues"
  },
  "homepage": "https://github.com/renshuo/dsh-iconic-quickbar#readme",
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "meta": {
      "title": "侧栏图标快捷栏",
      "description": "把左侧栏「新建会话」下方的面板列表改为一行无文字图标按钮（有哪些面板由宿主注册决定），行尾带一个开关可在原版列表与图标行之间切换。"
    }
  }
}
